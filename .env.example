# Local dev default. In production (Vercel), set MONGO_URI in
# Project Settings -> Environment Variables to a real MongoDB Atlas
# connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/booking-platform
# and allow 0.0.0.0/0 in Atlas Network Access (Vercel functions have no fixed IP).
MONGO_URI=mongodb://127.0.0.1:27017/booking-platform
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
